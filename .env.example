# Fill these in, then restart `npm run dev`.
# Dashboard: http://127.0.0.1:5173
# Webhook, if you expose this machine: http://<public-host>/api/telnyx/webhook

TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PHONE_NUMBER=
# Optional. Leave blank and the server creates one credential on the connection and reuses it.
TELNYX_TELEPHONY_CREDENTIAL_ID=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

PORT=8787

# Atlas is required. Data is migrated into this database before first start.
MONGODB_URI=
MONGODB_DB=agentic_desk

# Order confirmations: leave off until the setup below has been verified.
ORDER_AUTOMATION_ENABLED=false
# Natural-language assistant for registered orders on WhatsApp and SMS.
# Requires ORDER_AUTOMATION_ENABLED=true and GEMINI_API_KEY above.
TEXT_AGENT_ENABLED=false
# Optional conversational callbacks. Requires live order actions and Gemini Live access.
VOICE_AGENT_ENABLED=false
GEMINI_LIVE_MODEL=gemini-3.8-live
# Shared WhatsApp text/call gateway secret. Generated on startup if blank; never expose port 8795.
WHATSAPP_VOICE_TOKEN=
# A Voice API / Call Control application ID, separate from the WebRTC connection.
TELNYX_CALL_CONTROL_CONNECTION_ID=
# Public HTTPS origin forwarding to this server, without a path or trailing routes.
PUBLIC_BASE_URL=
# Optional separate SMS-enabled sending number; otherwise TELNYX_PHONE_NUMBER is used.
TELNYX_SMS_PHONE_NUMBER=
# Optional directory containing en.wav and ur.wav. Default: data/order-ivr.
ORDER_IVR_DIRECTORY=data/order-ivr
